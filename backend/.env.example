# Obtain a key from https://aistudio.google.com/app/apikey. Keep it backend-only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Obtain a key from https://app.tavily.com/home. Keep it backend-only.
TAVILY_API_KEY=
# Leave in development for local HTTP. For production, replace FRONTEND_ORIGINS
# with HTTPS deployment origins and set SESSION_COOKIE_SECURE=true.
FLASK_ENV=development
SECRET_KEY=
DATABASE_PATH=instance/research.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
MAX_SEARCH_RESULTS=8
SEARCH_DEPTH=basic
MAX_ACTIVE_RESEARCH_JOBS=2
